# Shared pins for the build-rootfs-bundle workflow (ci/rootfs-bundle/build.sh).
# RuntimeTest cross-pins these against RuntimeManifest (Artifact.kt) so the bundle
# is always built from the SAME rootfs the app's component path pins - the values
# below and the manifest cannot drift apart silently.
#
# The Firefox ESR version is a workflow input (default tracks RuntimeManifest's
# FIREFOX_ESR); its integrity does not rely on a hash pinned HERE: build.sh
# verifies the tarball's SHA-512 against Mozilla's own SHA512SUMS for that
# release at build time (fail closed), and records both hashes in the bundle's
# provenance manifest.
ROOTFS_URL=https://cdimage.ubuntu.com/ubuntu-base/releases/24.04.5/release/ubuntu-base-24.04.5-base-arm64.tar.gz
ROOTFS_SHA256=a91d5a93010193712d346d761372b7c9db6dfcf093893161c64ca107f05914f2
FIREFOX_RELEASES_BASE=https://archive.mozilla.org/pub/firefox/releases
FIREFOX_INSTALL_DIR=/opt/firefox-esr
BUNDLE_MANIFEST_PATH=/opt/win11we/bundle-manifest.txt
PREFIX_TEMPLATE_PATH=/opt/win11we/prefix-template
